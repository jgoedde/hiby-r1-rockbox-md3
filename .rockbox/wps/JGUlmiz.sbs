# Additional Fonts
%Fl(3,45-Ubuntu-Medium.fnt)
%Fl(4,50-Ubuntu-Medium.fnt)
%Fl(8,36-Ubuntu-Regular.fnt)
#
%X(sbs_bg.bmp)
#
#%V(0,0,-,-,-)
#
#%T(brightness,170,0,140,55,none)
%Vd(title)
#%?Tl(brightness, 4)<%Vd(brightness)|%Vd(title)>
#%?Tl(brightness, 5)<%dr(170,0,140,55,aaaaaa)>
#
# Cancel
%V(50,715,80,60,-) 
%T(cancel,0,0,-,-,cancel)
%T(cancel,0,0,-,-,menu,long_press)
#
# Resume (Go to WPS)
%V(350,715,80,60,-) 
%T(0,0,-,-,resumeplayback)
#
### VIEWPORTS
#
## Vi AREA (MENU)
%Vi(-,20,130,445,570,1)
#
# Volume
%xl(y,speaker.bmp,0,0,15)
%V(10,7,32,48,-)
%xd(yk)
%V(45,15,100,30,8) %Vf(cccccc)
%al%?if(%pv,<=,-1000)<%ss(0,4,%pv)|%?if(%pv,>,-100)<%?if(%pv,>=,0)<%ss(0,1,%pv)|%ss(0,2,%pv)>|%ss(0,3,%pv)>>dB
#
# Clock
%V(160,15,160,35,8) %Vf(cccccc)
%ac%?cf<%ck:%cM|     %cl:%cM %cp>
#
# Battery
%V(350,15,90,30,8)%Vf(cccccc)
%ar%bl%%
%V(450,17,15,28,-)%Vf(cccccc)
%dr(4,1,6,3)
%?bc<%Vf(99dd99)|%?bl<|%Vf(ee9999)||||>> 
%bl(0,4,-,-,vertical)
#
#%V(0,40,10,225,-)
#%?LB<%LB(0,0,10,225,invert)>
